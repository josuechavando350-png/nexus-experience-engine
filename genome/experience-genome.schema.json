{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/experience-genome-v0.1.json",
  "title": "Experience Genome v0.1 technique",
  "description": "A reusable creative capability expressed as intent, mechanics, constraints and evidence—not source code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "status", "domains", "intent", "objectiveMechanics", "triggers", "parameters", "dependencies", "implementationType", "cpuCost", "gpuCost", "memoryCost", "mobileViability", "accessibility", "reducedMotionBehavior", "fallback", "emotionalCharacter", "compatibleIndustries", "avoidWhen", "compatibleWith", "conflictsWith", "saturationScore", "originalityScore", "technicalDifficulty", "performanceTier", "implementationReference", "sourceObservations", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$", "description": "Record version for Genome v0.1."},
    "status": {"enum": ["DRAFT", "REVIEW", "VALIDATED", "DEPRECATED"]},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ART_DIRECTION", "MOTION", "CREATIVE_ENGINEERING", "GAME_INTERACTION", "CINEMATIC_LANGUAGE", "UX_BUSINESS"]}},
    "intent": {"type": "string", "minLength": 12, "description": "The user, creative, or business purpose; not a visual recipe."},
    "objectiveMechanics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "triggers": {"type": "array", "items": {"$ref": "#/$defs/namedDescription"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implementationType": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CSS", "DOM", "CANVAS_2D", "WEBGL", "SVG", "AUDIO", "MEDIA", "SERVER", "CONCEPTUAL"]}},
    "cpuCost": {"$ref": "#/$defs/cost"},
    "gpuCost": {"$ref": "#/$defs/cost"},
    "memoryCost": {"$ref": "#/$defs/cost"},
    "mobileViability": {"$ref": "#/$defs/mobile"},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["considerations", "keyboardBehavior", "screenReaderBehavior"], "properties": {"considerations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}, "keyboardBehavior": {"type": "string", "minLength": 5}, "screenReaderBehavior": {"type": "string", "minLength": 5}}},
    "reducedMotionBehavior": {"type": "string", "minLength": 8},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["strategy", "preservesIntent"], "properties": {"strategy": {"type": "string", "minLength": 8}, "preservesIntent": {"type": "string", "minLength": 8}}},
    "emotionalCharacter": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9 -]*$"}, "description": "Open vocabulary of emotional intentions (for example, quiet luxury or tension)."},
    "compatibleIndustries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "avoidWhen": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "compatibleWith": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
    "conflictsWith": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
    "saturationScore": {"$ref": "#/$defs/score", "description": "0 means rarely encountered; 100 means severely overused in the relevant contemporary context. Scores require dated evidence."},
    "originalityScore": {"$ref": "#/$defs/score", "description": "0 means conventional/undifferentiated; 100 means highly distinctive in the relevant context. It measures the abstraction, not ownership. Scores require evidence."},
    "technicalDifficulty": {"type": "integer", "minimum": 1, "maximum": 5, "description": "1 is straightforward; 5 requires specialist engineering and extensive validation."},
    "performanceTier": {"type": "object", "additionalProperties": false, "required": ["recommended", "variants"], "properties": {"recommended": {"$ref": "#/$defs/tier"}, "variants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["tier", "behavior"], "properties": {"tier": {"$ref": "#/$defs/tier"}, "behavior": {"type": "string", "minLength": 8}}}}}},
    "implementationReference": {"type": "object", "additionalProperties": false, "required": ["kind", "location"], "properties": {"kind": {"enum": ["NONE", "INTERNAL_PROTOTYPE", "INTERNAL_MODULE", "DESIGN_SPEC"]}, "location": {"type": ["string", "null"]}, "validationNotes": {"type": "string"}}},
    "sourceObservations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["observation", "sourceType", "observedAt"], "properties": {"observation": {"type": "string", "minLength": 8}, "sourceType": {"enum": ["FIRST_PARTY_TEST", "EXTERNAL_REFERENCE", "RESEARCH", "AUTHOR_HYPOTHESIS"]}, "sourceLocator": {"type": ["string", "null"]}, "observedAt": {"type": "string", "format": "date"}}}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "tier": {"enum": ["ULTRA", "HIGH", "MEDIUM", "STATIC"]},
    "cost": {"type": "object", "additionalProperties": false, "required": ["level", "rationale"], "properties": {"level": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "EXTREME"]}, "rationale": {"type": "string", "minLength": 5}}},
    "namedDescription": {"type": "object", "additionalProperties": false, "required": ["type", "description"], "properties": {"type": {"type": "string", "minLength": 2}, "description": {"type": "string", "minLength": 5}}},
    "parameter": {"type": "object", "additionalProperties": false, "required": ["name", "type", "description"], "properties": {"name": {"type": "string", "minLength": 1}, "type": {"enum": ["number", "string", "boolean", "enum", "object"]}, "description": {"type": "string", "minLength": 5}, "default": {}}},
    "mobile": {"type": "object", "additionalProperties": false, "required": ["rating", "desktopBehavior", "mobileBehavior", "touchAlternatives", "hoverReplacement", "gestureSupport", "reducedComplexity", "performanceFallback"], "properties": {"rating": {"enum": ["NATIVE", "ADAPTABLE", "LIMITED", "UNSUITABLE"]}, "desktopBehavior": {"type": "string", "minLength": 8}, "mobileBehavior": {"type": "string", "minLength": 8}, "touchAlternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}, "hoverReplacement": {"type": "string", "minLength": 5}, "gestureSupport": {"type": "array", "items": {"type": "string", "minLength": 3}}, "reducedComplexity": {"type": "string", "minLength": 8}, "performanceFallback": {"type": "string", "minLength": 8}}}
  }
}
